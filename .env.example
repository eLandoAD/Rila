# Copy to .env and fill in the real values. Never commit .env.

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Auth ---
# Generate with: openssl rand -base64 48
# Minimum 32 characters: HS256 requires a key of at least 256 bits (RFC 7518 3.2).
# A shorter value compiles and boots fine, then every login fails with 500
# (io.jsonwebtoken.security.WeakKeyException).
JWT_SECRET=change-me
JWT_EXPIRATION=3600000

# --- App ---
# Public URL of the frontend: it is what ends up in the verification emails.
FRONTEND_URL=http://localhost:4205
# Host port the nginx proxy is published on
PROXY_PORT=4205

# --- SMTP (real relay) ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- SMTP (local Mailpit catcher) ---
# To go back to Mailpit comment out the block above and uncomment this one.
# Web UI on http://localhost:8025
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=noreply@securevault.local
# SMTP_PASSWORD=
# SMTP_AUTH=false
# SMTP_STARTTLS=false
